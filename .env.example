# Cloudflare R2 自更新发布配置（scripts/release-r2.sh 读取）
# 本文件是模板；真实凭证请填到仓库根 .env（已被 .gitignore 忽略），切勿提交。

# R2 账户 ID（Cloudflare 右侧概览页）
R2_ACCOUNT_ID=""

# R2 API 令牌（管理 → R2 → 创建 API 令牌，仅授予该 bucket 的 Object Read/Write）
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# 公开桶名
R2_BUCKET="goodshare-updates"

# 自定义域（Cloudflare 后台把 bucket 设为公开桶后绑定的 CNAME，不含 https://）
# 例如 update.example.com，公开访问地址即 https://update.example.com/updates/...
R2_PUBLIC_DOMAIN="update.example.com"

# R2 内对象前缀（对应 App 更新源下的子目录，保持 updates 即可）
REMOTE_PREFIX="updates"

# 更新说明（留空则脚本自动取最近一条 git commit 信息）
CHANGELOG=""

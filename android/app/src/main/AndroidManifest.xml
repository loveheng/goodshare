<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MCP 内嵌 HTTP 服务 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 前台服务保活（flutter_foreground_task, dataSync） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 应用内自更新：拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- FAB 速记录音（record 插件） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- goodhub 本地插件签名权限：仅同签名 app 可 bind 本 MCP 服务（契约 §1.2.6，Bug2）。
         goodhub 侧需同步声明 <uses-permission android:name="com.zzh.goodhub.permission.MCP_SERVER"/>，
         且两 app 同签名（同机 debug keystore 一致即可）。 -->
    <permission
        android:name="com.zzh.goodhub.permission.MCP_SERVER"
        android:protectionLevel="signature" />

    <application
        android:label="拾贝"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 接收任意类型分享（文本/链接/图片/视频/文件） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task 前台服务（勿改名） -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"/>
        <!-- goodshare 本地 Binder 插件（goodhub 契约 thirdconnect.md §1.2）：
             系统级自动发现、随调随起、同签名零弹窗；Release 零端口。
             HTTP MCP server(:8765) 暂保留作回退（并行验证，#7 前移除）。 -->
        <service
            android:name=".McpBinderService"
            android:exported="true"
            android:permission="com.zzh.goodhub.permission.MCP_SERVER">
            <intent-filter>
                <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
            </intent-filter>
            <meta-data
                android:name="com.zzh.goodhub.SERVER_ID"
                android:value="goodshare" />
            <meta-data
                android:name="com.zzh.goodhub.SERVER_TITLE"
                android:value="GoodShare" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- goodhub 本地插件自动发现：声明可查询同 action 的服务（Android 11+ 包可见性） -->
        <intent>
            <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
        </intent>
    </queries>
</manifest>
